<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Text thông tin sinh viên -->
    <TextView
        android:id="@+id/tvThongTinSinhVien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Họ tên: Nguyễn Bảo Phúc - Môn: Lập trình Android\nLớp HP: IT2026"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- Ô nhập tên công việc -->
    <EditText
        android:id="@+id/edtTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên công việc"
        android:inputType="text" />

    <!-- Ô nhập mô tả công việc -->
    <EditText
        android:id="@+id/edtMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mô tả công việc"
        android:inputType="textMultiLine"
        android:minLines="3" />

    <!-- Nút Tạo công việc -->
    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tạo công việc" />

    <!-- Nút Xem danh sách công việc -->
    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Xem danh sách công việc" />

</LinearLayout>